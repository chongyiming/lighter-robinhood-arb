# Credentials
#
#   cp .env.example .env     then fill in
#
# The two legs are fully independent deployments: Lighter mainnet and
# Robinhood Chain each have their own account and API key, which must be
# registered and filled in separately. For how to generate keys, see
# https://github.com/elliottech/lighter-python
# NEVER commit .env to git.

# ===== Base leg: Lighter mainnet (--base lighter) =====
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=

# ===== Hedge leg: Lighter on Robinhood Chain (--hedge lighter-rh) =====
RH_ACCOUNT_INDEX=
RH_API_KEY_INDEX=
RH_API_PRIVATE_KEY=
